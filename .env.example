# Copy to .env for local development, or set the same names in
# Railway > your service > Variables. Never commit real values.

# ── Database ───────────────────────────────────────────────────────────
# Railway + Neon: paste Neon's connection string (Neon > Connect, pooling off).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
# Local PostgreSQL (used only when DATABASE_URL is empty):
DB_NAME=ASDBv11
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432

# ── Flask ──────────────────────────────────────────────────────────────
# Long random value, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Railway only: rate limiting reads the client IP from the proxy header.
TRUST_PROXY=1

# ── Email (verification codes) ─────────────────────────────────────────
# Railway blocks SMTP below the Pro plan, so use an HTTPS email API there.
# Option A — Brevo (free tier; verify a single sender address in Brevo):
BREVO_API_KEY=
EMAIL_FROM=your.verified.sender@gmail.com
EMAIL_FROM_NAME=PUP Lopez Scheduling System
# Option B — Resend (needs a domain verified in Resend):
RESEND_API_KEY=
# Option C — SMTP (local only), e.g. Gmail with an App Password:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: force one of brevo | resend | smtp
EMAIL_PROVIDER=
